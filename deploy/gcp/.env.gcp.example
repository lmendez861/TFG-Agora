# Puerto HTTP publicado por Docker en la VM.
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# Cambia estos valores antes de desplegar.
APP_SECRET=cambia-este-secreto-en-produccion
POSTGRES_DB=agora
POSTGRES_USER=agora
# Usa una password fuerte pero sin caracteres reservados de URL como @ o :.
POSTGRES_PASSWORD=cambia-esta-password

# Usa un host publico que resuelva a la VM.
# Ejemplos:
# APP_PUBLIC_HOST=agora.34.175.120.10.nip.io
# APP_EXTERNAL_BASE_URL=https://agora.34.175.120.10.nip.io
# DEFAULT_URI=https://agora.34.175.120.10.nip.io
APP_PUBLIC_HOST=TU_HOST_PUBLICO
APP_EXTERNAL_BASE_URL=https://TU_HOST_PUBLICO
DEFAULT_URI=https://TU_HOST_PUBLICO
ACME_EMAIL=
TRUSTED_PROXIES=private_ranges

# Correo transaccional real.
MAILER_DSN=brevo+api://BREVO_API_KEY@default
APP_MAIL_FROM=sender-verificado@tu-dominio.com
APP_INTERNAL_MFA_EMAIL=seguridad@tu-dominio.com

APP_MFA_TTL_SECONDS=600
APP_ENABLE_DEMO_TEACHERS=0
DEMO_TEACHER_PASSWORD=
APP_ENABLE_DESKTOP_OPERATORS=0
DESKTOP_ADMIN_PASSWORD=
DESKTOP_MONITOR_PASSWORD=

# Regex amplia para IP publica o dominio.
CORS_ALLOW_ORIGIN=^https?://[A-Za-z0-9.-]+(:[0-9]+)?$
